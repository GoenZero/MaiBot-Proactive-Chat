{
  "manifest_version": 2,
  "id": "com.goenzero.proactive_chat",
  "version": "0.1.0",
  "name": "主动聊天 / Proactive Chat",
  "description": "聊天安静一段时间、到了 AI 自己约好的时间、或 AI 主动说话对方没回时，用 MaiBot 自带的主动任务提醒 AI。说不说、说什么由 AI 自己决定。",
  "author": {
    "name": "GoenZero",
    "url": "https://github.com/GoenZero"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/GoenZero/MaiBot-Proactive-Chat",
    "homepage": "https://github.com/GoenZero/MaiBot-Proactive-Chat",
    "issues": "https://github.com/GoenZero/MaiBot-Proactive-Chat/issues"
  },
  "host_application": {
    "min_version": "1.3.5",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "message-circle"
    }
  },
  "capabilities": [
    "maisaka.proactive.trigger",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
